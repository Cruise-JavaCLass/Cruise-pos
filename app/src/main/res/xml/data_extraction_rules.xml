<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <!-- Exclude sensitive auth credentials, session tokens and keys from cloud backup -->
        <exclude domain="sharedpref" path="kmp_pos_session.xml"/>
        <exclude domain="sharedpref" path="kmp_pos_token_storage.xml"/>
        <exclude domain="sharedpref" path="credentials.xml"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="kmp_pos_session.xml"/>
        <exclude domain="sharedpref" path="kmp_pos_token_storage.xml"/>
        <exclude domain="sharedpref" path="credentials.xml"/>
        <exclude domain="sharedpref" path="auth_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
